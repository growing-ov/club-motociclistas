# ---------------------------------------------------------------------------
# Copia este archivo como .env y ajusta los valores:
#   Windows PowerShell : copy .env.example .env
#   Linux / macOS      : cp .env.example .env
# El archivo .env NO se versiona (esta en .gitignore y .dockerignore).
# ---------------------------------------------------------------------------

# --- Django -----------------------------------------------------------------
# Clave de Django (firma cookies y CSRF). En produccion debe ser larga y
# unica: genera una con
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambia-esta-clave
# "true" activa DEBUG. En produccion: False
DEBUG=True
# Hosts permitidos, separados por comas. "*" solo para desarrollo.
ALLOWED_HOSTS=*

# --- MongoDB (MongoDB Atlas) -------------------------------------------------
# URI de conexion a Atlas. Sustituye USUARIO, CLAVE y CLUSTER por los datos
# de tu cluster (MongoDB Atlas > Connect > Drivers).
MONGO_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Si tu cluster exige TLS con certificados validos, añade al final:
#   &tls=true&tlsAllowInvalidCertificates=false
# Nombre de la base de datos dentro del servidor Mongo.
MONGO_DB=club_motociclistas

# --- Solo Docker Compose ----------------------------------------------------
# Puerto del host donde se publica la aplicacion.
PUERTO_WEB=8000
# Segundos que el entrypoint espera a MongoDB antes de arrancar (0 = sin espera).
ESPERA_MONGO=60
